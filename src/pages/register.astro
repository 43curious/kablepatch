---
import { createSession, createUser, isSameOrigin } from '../server/auth';
import '../styles/account.css';

let error = '';
const requestedNext = Astro.url.searchParams.get('next') ?? '/app/';
const nextPath = requestedNext.startsWith('/app/') || requestedNext === '/app' ? requestedNext : '/app/';
let email = '', displayName = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? ''); displayName = String(form.get('displayName') ?? '');
  const password = String(form.get('password') ?? ''), confirmation = String(form.get('confirmation') ?? '');
  const submittedNext = String(form.get('next') ?? '/app/');
  const safeNext = submittedNext.startsWith('/app/') || submittedNext === '/app' ? submittedNext : '/app/';
  if (!isSameOrigin(Astro.request)) error = 'The request could not be verified. Please try again.';
  else if (password !== confirmation) error = 'Passwords do not match.';
  else {
    const result = await createUser({ email, displayName, password });
    if ('user' in result) { createSession(result.user.id, Astro.cookies); return Astro.redirect(safeNext, 303); }
    error = result.error;
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Create an Iko Connect account and workspace." />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>Create account — Iko Connect</title>
  </head>
  <body>
    <main class="auth-shell">
      <a class="auth-brand" href="/"><span class="auth-mark"><i></i><i></i><i></i></span>Iko Connect</a>
      <section class="auth-card register-card">
        <header><span class="auth-icon" aria-hidden="true">＋</span><p>Your workspace</p><h1>Create your account.</h1><span>Keep each diagram in its own project and return from any signed-in session.</span></header>
        {error && <div class="auth-error" role="alert">{error}</div>}
        <form method="post">
          <input type="hidden" name="next" value={nextPath} />
          <label>Name<input name="displayName" value={displayName} autocomplete="name" minlength="2" maxlength="80" required autofocus /></label>
          <label>Email address<input type="email" name="email" value={email} autocomplete="email" maxlength="254" required /></label>
          <label>Password<input type="password" name="password" autocomplete="new-password" minlength="12" maxlength="256" required /><small>Use at least 12 characters.</small></label>
          <label>Confirm password<input type="password" name="confirmation" autocomplete="new-password" minlength="12" maxlength="256" required /></label>
          <button type="submit">Create account <span aria-hidden="true">→</span></button>
        </form>
        <footer>Already have an account? <a href={`/login/?next=${encodeURIComponent(nextPath)}`}>Sign in</a></footer>
      </section>
      <p class="auth-note">Projects are private to your account.</p>
    </main>
  </body>
</html>
